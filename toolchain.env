# Pinned by digest, not the :44 tag, so the build toolchain can't drift.
BUILDER_IMAGE=registry.fedoraproject.org/fedora@sha256:0c6072366ebf8ea1c8c0f3a118aad3e9a9247d3065d499e54d62968f69351966

# CPU flags for packages that opt into Armada-specific tuning. The default is
# unchanged for existing targets; select sm8250 for Cortex-A77/A55 devices.
case "${ARMADA_CPU_PROFILE:-default}" in
	default)
		ARMADA_MARCH="-march=armv8.2-a+fp16+dotprod+i8mm -mtune=cortex-a78"
		;;
	sm8250)
		ARMADA_MARCH="-march=armv8.2-a+fp16+dotprod -mtune=cortex-a77"
		;;
	*)
		echo "Unknown ARMADA_CPU_PROFILE: ${ARMADA_CPU_PROFILE}" >&2
		return 2 2>/dev/null || exit 2
		;;
esac
